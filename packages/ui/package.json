{
  "name": "@moksha-ui/core",
  "version": "0.1.0",
  "description": "React and React Native components with one API, built on @moksha-ui/tokens",
  "license": "MIT",
  "author": "Shivastu Shrivastava <shivastuu@gmail.com>",
  "keywords": [
    "react",
    "react-native",
    "design-system",
    "components",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivastuu/moksha-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/shivastuu/moksha-ui#readme",
  "bugs": {
    "url": "https://github.com/shivastuu/moksha-ui/issues"
  },
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "react-native": "./lib/module/index.native.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./lib/module/index.native.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "test": "vitest run && jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moksha-ui/tokens": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "~19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jsdom": "^31.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "test-renderer": "^1.3.1",
    "vitest": "^5.1.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.test.ts,*.test.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
