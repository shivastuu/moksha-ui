{
  "name": "@shivastu/tokens",
  "version": "0.1.0",
  "description": "Design tokens (colors, typography, spacing, radius) for web and React Native",
  "license": "MIT",
  "author": "Shivastu Shrivastava <shivastuu@gmail.com>",
  "keywords": [
    "design-tokens",
    "react-native",
    "design-system"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --no-warnings --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
